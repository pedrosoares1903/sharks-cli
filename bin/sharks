#!/usr/bin/env bash
set -euo pipefail

RAIZ="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${RAIZ}/lib/api.sh"
source "${RAIZ}/lib/format.sh"

VERSAO="0.1.0"

uso() {
  cat <<'AJUDA'
sharks — consulta dados dos San Jose Sharks (API publica da NHL)

Utilizacao:
  sharks next         proximo jogo
  sharks --version    mostra a versao
  sharks --help       mostra esta mensagem

Variaveis de ambiente:
  EQUIPA   codigo da equipa (por omissao: SJS)
  EPOCA    epoca a consultar (por omissao: now)
AJUDA
}

# Primeiro jogo por disputar de um calendario, ou "null".
primeiro_jogo_futuro() {
  jq -c '[.games[] | select(.gameState == "FUT" or .gameState == "PRE")] | first' <<<"$1"
}

cmd_next() {
  local calendario jogo epoca_usada total

  calendario=$(api_calendario)
  epoca_usada=$(jq -r '.currentSeason' <<<"$calendario")
  jogo=$(primeiro_jogo_futuro "$calendario")

  # A epoca devolvida por "now" pode ja ter terminado, se a seguinte
  # ainda nao arrancou. Nesse caso tentamos a epoca seguinte.
  if [ "$jogo" = "null" ] && [ "$EPOCA" = "now" ]; then
    epoca_usada=$(epoca_seguinte "$epoca_usada")
    calendario=$(api_calendario "$epoca_usada")
    jogo=$(primeiro_jogo_futuro "$calendario")
  fi

  if [ "$jogo" = "null" ]; then
    total=$(jq -r '.games | length' <<<"$calendario")
    echo "Sem jogos por disputar na epoca ${epoca_usada} (${total} jogos no calendario)." >&2
    echo "Para consultar outra epoca: EPOCA=20262027 sharks next" >&2
    exit 1
  fi

  formata_jogo "$jogo"
}

case "${1:-}" in
  next)         cmd_next ;;
  ""|-h|--help) uso ;;
  --version)    echo "sharks $VERSAO" ;;
  *)
    echo "comando desconhecido: $1" >&2
    uso >&2
    exit 1
    ;;
esac
